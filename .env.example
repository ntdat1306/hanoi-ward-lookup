# Google Maps Platform key with the Places API (New) and the Routes API enabled
GOOGLE_MAPS_API_KEY=

# Optional: days a cached Google answer is reused before it is asked again (default 30)
# GOOGLE_CACHE_TTL_DAYS=30

# Optional: folder of hanoi-moving-insights-api used by "pnpm push-db" and, for its .env and mysql2, by "pnpm process"
# (default: the sibling folder)
# MOVES_API_DIR=../hanoi-moving-insights-api

# Optional: MySQL connection for "pnpm process" (read only). Unset values are taken from the API project's .env
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=hanoi_moving_insights
